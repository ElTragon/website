---
import { getCollection } from "astro:content"
import BaseLayout from "../layouts/BaseLayout.astro"
import { comparePostsDescending, postPath } from "../utils/blog-routes"

const posts = (await getCollection("blog")).sort(comparePostsDescending)
const newestPost = posts[0]

const outcomes = [
  {
    value: "50%",
    label: "faster client onboarding through self-service HL7 tooling",
  },
  {
    value: "5s to <1s",
    label: "research-platform page load improvement",
  },
  {
    value: "200+",
    label: "staff supported across twelve regulated applications",
  },
]

const selectedWork = [
  {
    organization: "Molecular Testing Labs",
    title: "Self-service healthcare integrations",
    description:
      "Turned a client-onboarding bottleneck into HL7 integration tooling that laboratory staff could operate independently.",
    result: "Reduced onboarding time by 50%",
  },
  {
    organization: "University of Southern California",
    title: "Research platform modernization",
    description:
      "Partnered with researchers, product stakeholders, and designers to improve a sensitive-data platform built with Svelte and Rust.",
    result: "Improved page loads from 5 seconds to under 1 second",
  },
  {
    organization: "Molecular Testing Labs",
    title: "Laboratory operations platform",
    description:
      "Connected laboratory, customer, equipment, and business workflows through a secure API gateway, NetSuite ERP, Kafka, and Azure services.",
    result: "Automated order workflows and improved operational visibility",
  },
]

const workingStyle = [
  "Learn the workflow from the people closest to it.",
  "Translate constraints into a clear technical plan.",
  "Build across product, integrations, and infrastructure.",
  "Deploy, document, and enable the team that owns the outcome.",
]
---

<BaseLayout
  title="Full-Stack Engineer for Complex Customer Problems"
  description="Mario Lopez is a full-stack software engineer specializing in integrations, customer workflows, regulated systems, and reliable product delivery."
  pathname="/"
>
  <section class="hero" aria-labelledby="hero-title">
    <p class="hero-name">Mario Lopez</p>
    <h1 id="hero-title">Full-Stack Engineer for Complex Customer Problems</h1>
    <p class="hero-summary">
      I work with customers and domain experts to understand operational
      problems, build integrations and products, and deploy reliable solutions.
    </p>
    <div class="hero-actions" aria-label="Primary actions">
      <a class="primary-action" href="#work">View Work</a>
      <a class="secondary-action" href="#contact">Contact Me</a>
    </div>
  </section>

  <section class="outcomes" aria-label="Selected outcomes">
    {
      outcomes.map(outcome => (
        <div class="outcome">
          <strong>{outcome.value}</strong>
          <span>{outcome.label}</span>
        </div>
      ))
    }
  </section>

  <section id="work" class="home-section" aria-labelledby="work-title">
    <div class="section-heading">
      <p>Selected work</p>
      <h2 id="work-title">From unclear workflows to dependable systems</h2>
    </div>
    <div class="work-list">
      {
        selectedWork.map(project => (
          <article class="work-item">
            <p class="work-organization">{project.organization}</p>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <p class="work-result">{project.result}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="home-section approach" aria-labelledby="approach-title">
    <div class="section-heading">
      <p>How I work</p>
      <h2 id="approach-title">Engineering starts with understanding</h2>
    </div>
    <ol>
      {
        workingStyle.map((step, index) => (
          <li>
            <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            {step}
          </li>
        ))
      }
    </ol>
  </section>

  <section id="about" class="home-section" aria-labelledby="about-title">
    <div class="section-heading">
      <p>About</p>
      <h2 id="about-title">Technical range with an operational focus</h2>
    </div>
    <p class="section-copy">
      I am a California-based software engineer with experience across
      healthcare, research, databases, fintech, and small businesses. My work
      spans customer discovery, frontend systems, backend services, APIs, cloud
      infrastructure, security, testing, and technical documentation.
    </p>
    <p class="section-copy">
      I am especially interested in forward-deployed work where learning a
      customer’s domain is as important as writing the software.
    </p>
  </section>

  {
    newestPost && (
      <section class="home-section" aria-labelledby="writing-title">
        <div class="section-heading">
          <p>Latest writing</p>
          <h2 id="writing-title">Sharing what I learn</h2>
        </div>
        <article class="latest-post">
          <h3>
            <a href={postPath(newestPost)}>{newestPost.data.title}</a>
          </h3>
          <p>{newestPost.data.description}</p>
          <a href={postPath(newestPost)}>Read the article</a>
        </article>
        <a class="text-link" href="/blogs/">
          View all writing
        </a>
      </section>
    )
  }

  <section
    id="contact"
    class="home-section contact"
    aria-labelledby="contact-title"
  >
    <div class="section-heading">
      <p>Contact</p>
      <h2 id="contact-title">Let’s solve something complicated</h2>
    </div>
    <p class="section-copy">
      I’m interested in forward-deployed and full-stack engineering roles where
      customer problems, integrations, and reliable delivery matter.
    </p>
    <div class="contact-links">
      <a href="mailto:m9lopeztri@gmail.com">m9lopeztri@gmail.com</a>
      <a href="tel:+18184896242">818-489-6242</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--spacing-16) 0 var(--spacing-12);
  }

  .hero-name,
  .section-heading > p,
  .work-organization {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--fontSize-0);
    font-weight: var(--fontWeight-bold);
    letter-spacing: 0.08em;
    margin-bottom: var(--spacing-3);
    text-transform: uppercase;
  }

  .hero h1 {
    color: var(--color-text);
    font-size: clamp(2.5rem, 7vw, 4.8rem);
    letter-spacing: -0.045em;
    margin: 0;
    max-width: 13ch;
  }

  .hero-summary {
    color: #a8b2d1;
    font-family: var(--font-heading);
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    margin-top: var(--spacing-6);
    max-width: 42rem;
  }

  .hero-actions,
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-4);
  }

  .primary-action,
  .secondary-action {
    border: 1px solid var(--color-primary);
    border-radius: 0.35rem;
    display: inline-flex;
    font-family: var(--font-heading);
    font-weight: var(--fontWeight-bold);
    justify-content: center;
    padding: var(--spacing-3) var(--spacing-5);
    text-decoration: none;
  }

  .primary-action {
    background: var(--color-primary);
    color: #0a192f;
  }

  .secondary-action {
    color: var(--color-primary);
  }

  .primary-action:hover,
  .primary-action:focus-visible,
  .secondary-action:hover,
  .secondary-action:focus-visible {
    box-shadow: 0 0 0 3px rgb(101 200 124 / 25%);
  }

  .outcomes {
    border-bottom: 1px solid #233554;
    border-top: 1px solid #233554;
    display: grid;
    gap: var(--spacing-6);
    grid-template-columns: repeat(3, 1fr);
    padding: var(--spacing-8) 0;
  }

  .outcome {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .outcome strong {
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: var(--fontSize-4);
  }

  .outcome span {
    color: #a8b2d1;
    line-height: var(--lineHeight-relaxed);
  }

  .home-section {
    padding-top: var(--spacing-20);
    scroll-margin-top: var(--spacing-8);
  }

  .section-heading h2 {
    color: var(--color-text);
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin: 0 0 var(--spacing-8);
    max-width: 24ch;
  }

  .work-list {
    display: grid;
    gap: var(--spacing-5);
  }

  .work-item,
  .latest-post {
    border-left: 2px solid #233554;
    padding: var(--spacing-2) 0 var(--spacing-2) var(--spacing-6);
  }

  .work-item h3,
  .latest-post h3 {
    color: var(--color-primary);
    margin: 0 0 var(--spacing-3);
  }

  .work-item p,
  .latest-post p {
    color: #a8b2d1;
    margin-bottom: var(--spacing-3);
  }

  .work-item .work-organization {
    margin-bottom: var(--spacing-2);
  }

  .work-result {
    color: var(--color-text) !important;
    font-family: var(--font-heading);
    font-weight: var(--fontWeight-bold);
  }

  .approach ol {
    list-style: none;
    margin: 0;
  }

  .approach li {
    align-items: baseline;
    border-bottom: 1px solid #233554;
    display: grid;
    font-family: var(--font-heading);
    font-size: var(--fontSize-2);
    gap: var(--spacing-4);
    grid-template-columns: 2rem 1fr;
    margin: 0;
    padding: var(--spacing-5) 0;
  }

  .approach li span {
    color: var(--color-primary);
    font-size: var(--fontSize-0);
  }

  .section-copy {
    color: #a8b2d1;
    font-size: var(--fontSize-2);
    max-width: 46rem;
  }

  .text-link {
    display: inline-block;
    font-family: var(--font-heading);
    margin-top: var(--spacing-5);
  }

  .contact {
    padding-bottom: var(--spacing-16);
  }

  .contact-links a {
    font-family: var(--font-heading);
    overflow-wrap: anywhere;
  }

  @media (max-width: 42rem) {
    .hero {
      padding-top: var(--spacing-10);
    }

    .outcomes {
      grid-template-columns: 1fr;
    }

    .home-section {
      padding-top: var(--spacing-16);
    }

    .work-item,
    .latest-post {
      padding-left: var(--spacing-4);
    }
  }
</style>
