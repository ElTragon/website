{
  "name": "gatsby-starter-blog",
  "private": true,
  "description": "Mario Lopez, the software engineer crafting responsive sites and web-apps. Stay on the cutting edge of innovation and join Mario on his journey through the ever-evolving world of technology.",
  "version": "0.1.0",
  "author": "Mario Lopez <m9lopeztri@gmail.com>",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.8 <11"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  },
  "dependencies": {
    "@fontsource/merriweather": "^4.5.14",
    "@fontsource/montserrat": "^4.5.14",
    "dotenv": "^16.3.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-feed": "^5.16.0",
    "gatsby-plugin-google-gtag": "^5.16.0",
    "gatsby-plugin-image": "^3.16.0",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-netlify": "^5.1.1",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sharp": "^5.16.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-remark-images": "^7.16.0",
    "gatsby-remark-prismjs": "^7.16.0",
    "gatsby-remark-responsive-iframe": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "gatsby-transformer-sharp": "^5.16.0",
    "mermaid": "^10.2.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^4.9.0"
  },
  "devDependencies": {
    "@netlify/plugin-lighthouse": "6.0.4",
    "@playwright/test": "1.62.1",
    "autoprefixer": "^10.4.14",
    "gatsby-plugin-postcss": "^6.16.0",
    "postcss": "^8.5.25",
    "prettier": "2.8.8",
    "tailwindcss": "^3.3.2",
    "typescript": "7.0.2"
  },
  "homepage": "https://github.com/gatsbyjs/gatsby-starter-blog#readme",
  "keywords": [
    "gatsby"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gatsbyjs/gatsby-starter-blog.git"
  },
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "build": "gatsby build",
    "develop": "gatsby develop",
    "prettier": "prettier --check './**/*.{js,jsx,ts,tsx,md}'",
    "prettier-fix": "prettier --write \"./**/*.@(js|jsx|ts|tsx|md)\"",
    "prebuild": "gatsby clean",
    "start": "gatsby develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "npm run typecheck && GATSBY_ROUTING_FIXTURE=1 npm run build && npm run test:e2e",
    "pretest:e2e": "playwright install --only-shell chromium",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  }
}
