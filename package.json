{
  "name": "mario-lopez-blog",
  "type": "module",
  "private": true,
  "description": "Mario Lopez's software engineering blog and portfolio.",
  "version": "0.1.0",
  "author": "Mario Lopez <m9lopeztri@gmail.com>",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.1 <23",
    "npm": ">=10.9.8 <11"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/netlify": "^8.1.3",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/merriweather": "^4.5.14",
    "@fontsource/montserrat": "^4.5.14",
    "astro": "^7.1.6",
    "github-slugger": "2.0.0",
    "lodash": "4.17.21",
    "marked": "^18.0.7",
    "mermaid": "^10.2.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@netlify/plugin-lighthouse": "6.0.4",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.5.25",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^3.3.2",
    "typescript": "6.0.3"
  },
  "keywords": [
    "astro",
    "blog",
    "portfolio"
  ],
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElTragon/website.git"
  },
  "scripts": {
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/generate-redirects.mjs",
    "develop": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prettier": "prettier --check './**/*.{js,jsx,mjs,ts,tsx,astro,md}'",
    "prettier-fix": "prettier --write './**/*.{js,jsx,mjs,ts,tsx,astro,md}'",
    "start": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "serve": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "build:test": "ASTRO_ROUTING_FIXTURE=1 npm run build",
    "test": "npm run build:test && npm run test:e2e",
    "pretest:e2e": "playwright install --only-shell chromium",
    "test:e2e": "playwright test",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check"
  }
}
